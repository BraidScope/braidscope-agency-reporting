# Braidscope self-host settings. install.sh writes this file for you with
# random secrets. Edit by hand only if you know why.

# Where people open the app. localhost for a local test, your domain for real.
DOMAIN=localhost
PUBLIC_URL=http://localhost
# Email Let's Encrypt can reach about certificates (only used with a real domain).
ACME_EMAIL=

# --- Secrets. Generated by install.sh. Never share, never commit. ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
CONNECTOR_TOKEN_ENCRYPTION_KEY=
# How long a sign-in token lives, in seconds.
JWT_EXPIRY=3600

# --- Sign up ---
# true = only invited people and the first owner can get an account.
DISABLE_SIGNUP=false
# true = no confirmation email needed (set false once SMTP below is filled).
ENABLE_EMAIL_AUTOCONFIRM=true

# --- Email for password reset and invitations (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Braidscope
# App notification email through Resend (optional; in-app notifications work without it)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Connectors (optional; fill the ones you use) ---
META_ADS_MCP_CLIENT_ID=
META_ADS_MCP_CLIENT_SECRET=
GA4_MCP_CLIENT_ID=
GA4_MCP_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Images (leave blank to build from source) ---
PY_IMAGE=
WEB_IMAGE=
GIT_COMMIT=selfhost
