.pytest_cache/
py/.codex-debug/
py/.codex-debug-err.txt
py/.codex-debug-out.txt

# Vite writes a transient compiled config next to vite.config.js during builds
web/vite.config.js.timestamp-*.mjs

# Self-host runtime files
deploy/selfhost/.env
deploy/selfhost/.first-owner
deploy/selfhost/backups/
