# Copy to .env on the VPS and fill real values. NEVER commit .env.

# --- Domain ---
DOMAIN=braidscope.com

# --- Supabase (managed Postgres + auth) — wired in Phase 2 ---
# Get these from supabase.com → project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Server-side connection string (use the pooled "session" connection for migrations)
DATABASE_URL=

# --- Self-hosted Postgres (legacy, will be removed once Supabase is live) ---
POSTGRES_USER=braidscope
POSTGRES_PASSWORD=
POSTGRES_DB=braidscope

# --- Shared JWT secret (Node signs, Python verifies). Same value both services. ---
SHARED_JWT_SECRET=

# --- Node API ---
NODE_ENV=production
API_PORT=4000

# --- Python service ---
# production (default, strict: refuses to start with missing secrets) or development
APP_ENV=production
PY_PORT=8000
# Optional: mirror debug_log() output to a file (developer machines only)
BRAIDSCOPE_DEBUG_LOG_FILE=
# Per-IP rate limits on Ask AI, connector sign-in and invitations are on by default. 1 turns them off.
RATE_LIMIT_DISABLED=
REDIS_URL=redis://redis:6379/0
APP_BASE_URL=https://braidscope.com
WEB_BASE_URL=https://braidscope.com
# The official OpenAI Codex CLI must be installed in the Python service image
# and available as `codex`. Use browser for local interactive dev; use device
# for headless Linux/Docker where the backend cannot open a browser.
CODEX_CLI_COMMAND=codex
CODEX_LOGIN_MODE=browser
CODEX_HOME_ROOT=/var/lib/braidscope/codex
# The official Claude Code CLI (npm i -g @anthropic-ai/claude-code) must be available
# as `claude`. Each user's Claude sign-in lives in its own isolated config directory
# under CLAUDE_CONFIG_ROOT (one per user+client; contains credentials - keep private).
CLAUDE_CLI_COMMAND=claude
CLAUDE_CONFIG_ROOT=/var/lib/braidscope/claude

# --- AI provider ---
# Ask AI requires each client to connect OpenRouter through OAuth.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Product notification email (Phase 3, py/app/email_service.py) ---
# Separate from Supabase Auth's own email (signup/reset/invite, unaffected).
# Optional: without RESEND_API_KEY, notification email is silently skipped —
# in-app notifications work regardless. Get a key at resend.com; the "from"
# address's domain must be verified there before sending will succeed.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Braidscope <no-reply@auth.braidscope.cloud>"

# --- Shopify connector ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://braidscope.com/py/connectors/shopify/oauth/callback
SHOPIFY_API_VERSION=2026-01
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# --- Meta Ads connector ---
# Create a Meta/Facebook app and add this redirect URI:
# https://your-domain.com/py/connectors/meta-ads/oauth/callback
META_ADS_MCP_CLIENT_ID=
META_ADS_MCP_CLIENT_SECRET=
META_ADS_MCP_URL=http://py:8000/mcp/meta-ads
META_GRAPH_API_VERSION=v20.0

# --- Google Analytics 4 connector ---
# Uses Google OAuth (scope analytics.readonly) and the official Analytics Data API.
# In Google Cloud Console create an OAuth client and add this redirect URI:
#   https://your-domain.com/py/connectors/google-analytics-4/oauth/callback
# Enable "Google Analytics Data API" and "Google Analytics Admin API" on the project.
GA4_MCP_CLIENT_ID=
GA4_MCP_CLIENT_SECRET=
GA4_MCP_URL=http://py:8000/mcp/ga4
# Optional local/dev fallback bearer token. Leave blank in production; use OAuth per client instead.
GA4_MCP_ACCESS_TOKEN=
# Optional: default GA4 property ID (digits only). Omit to auto-use the first
# property the connected account can access.
GA4_PROPERTY_ID=
